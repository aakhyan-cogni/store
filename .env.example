# Copy to .env and fill in. Every variable here is validated at startup by
# src/lib/env.ts: the server refuses to boot rather than fail at request time.

PORT=5000
NODE_ENV=development
DATABASE_URL=postgres://user:password@localhost:5432/store

# At least 32 characters. HS256 is only as strong as this secret, so generate
# it rather than choosing it:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Token lifetime: seconds, or a duration like 15m / 1h / 7d. Max 30d.
JWT_EXPIRES_IN=1h
