{
	"name": "store",
	"version": "1.0.0",
	"description": "A simple CRUD REST API",
	"license": "MIT",
	"author": "Aakhyan",
	"type": "module",
	"main": "dist/index.js",
	"imports": {
		"#lib": "./dist/lib/index.js",
		"#src/*": "./dist/*/index.js"
	},
	"scripts": {
		"test": "vitest run",
		"dev": "node --watch --env-file=.env dist/index.js",
		"build": "npm run build:code && npm run openapi:generate",
		"build:code": "tsc",
		"openapi:generate": "node dist/commands/generateOpenApi.js",
		"openapi:check": "node dist/commands/generateOpenApi.js --check",
		"docs:mintlify": "node dist/commands/mintlifyPreview.js",
		"watch": "tsc --watch",
		"start": "node --env-file=.env dist/index.js",
		"typecheck": "tsc --noEmit",
		"typecheck:tests": "tsc --project tsconfig.test.json",
		"lint": "oxlint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"ci": "npm run format:check && npm run lint && npm run typecheck && npm run typecheck:tests && npm test",
		"up": "concurrently \"npm run watch\" \"npm run dev\" --kill-others",
		"migrate:up": "node --env-file=.env migrations/script.js up",
		"migrate:down": "node --env-file=.env migrations/script.js down",
		"migrate:status": "node --env-file=.env migrations/script.js status",
		"ui": "vitest --ui",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@scalar/openapi-parser": "^0.29.6",
		"@types/bcrypt": "^6.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^26.2.0",
		"@vitest/coverage-v8": "^5.0.0",
		"@vitest/ui": "^5.0.0",
		"concurrently": "^10.0.5",
		"oxlint": "^1.85.0",
		"oxlint-tsgolint": "^7.0.2002",
		"prettier": "^3.9.9",
		"typescript": "^7.0.2",
		"vitest": "^5.0.0"
	},
	"dependencies": {
		"bcrypt": "^6.0.0",
		"colorette": "^2.0.20",
		"jsonwebtoken": "^9.0.3",
		"postgres": "^3.4.9",
		"winston": "^3.19.0",
		"zod": "^4.4.3"
	},
	"allowScripts": {
		"bcrypt@6.0.0": true
	}
}
